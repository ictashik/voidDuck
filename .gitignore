# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Built APKs ship to the human out-of-band; not tracked here.
/outputs/
*.apk

# Bundled on-device models (CLAUDE.md non-negotiable #7: bundled as an APK
# asset, never downloaded at runtime — but "bundled" means present in the
# working tree for the build, not committed to git). Sourced manually into
# assets/models/ per the spec; multi-GB files with no Git LFS configured
# here, so keeping them out of history avoids permanently bloating .git and
# GitHub's 100MB-per-file push limit (gemma-4-E2B-it.litertlm alone is 2.4GB).
assets/models/*.litertlm
assets/models/*.task
assets/models/*.tflite
assets/models/moonshine_tokenizer.json
