<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Camera access only. INTERNET must never appear (CLAUDE.md non-negotiable #1). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- google_mlkit_face_detection's underlying com.google.mlkit:face-detection AAR pulls in
         play-services-mlkit-face-detection + Firebase's datatransport-cct, which declare these
         two permissions for telemetry/model-delivery plumbing we never use — face detection
         itself runs fully on-device. Force-strip them so they can't leak into the merged
         manifest (CLAUDE.md non-negotiable #1). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- RECORD_AUDIO (CLAUDE.md non-negotiable #6): explicit, separate decision for
         gesture-triggered voice recording. The mic is only ever live for one bounded
         window per Open_Palm trigger (end of the 3-2-1 countdown until Closed_Fist or
         the hard time cap) — never continuously listening, no wake word. Verify this
         permission's presence against the *merged* manifest with the same discipline
         as the INTERNET check above. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- camera_android_camerax declares these for its video/photo-capture APIs. We
         never save media to disk (camera frames or the mic clip both stay in RAM —
         CLAUDE.md non-negotiable #2), so storage permissions stay stripped. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <application
        android:label="voidduck"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
